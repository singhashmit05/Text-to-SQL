# Free tier — get a key at https://aistudio.google.com/apikey (no card required)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Use the READ-ONLY role — see app/db/session.py docstring for the GRANT statements
# Supabase: use the "Session pooler" connection string (Project Settings > Database
# > Connection string > Session mode), NOT the "Transaction pooler" one — the
# transaction pooler doesn't support prepared statements, which SQLAlchemy needs
# for a persistent connection pool. Append ?sslmode=require.
# Example: postgresql+psycopg2://sql_agent_ro.xxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://sql_agent_ro.xxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Used ONLY by the dataset-upload feature to create tables (needs CREATE/INSERT).
# On Supabase, use your default "postgres" role's connection string
# (Project Settings > Database > Connection string > Session pooler).
# The agent's queries NEVER use this connection — only app/db/loader.py does.
DATABASE_ADMIN_URL=postgresql+psycopg2://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
MAX_UPLOAD_MB=15
MAX_UPLOAD_ROWS=200000

MAX_ROWS_RETURNED=200
DEFAULT_TOP_K=5
QUERY_TIMEOUT_SECONDS=15
MAX_AGENT_RETRIES=2

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=text2sql-agent

# Comma-separated. Add your deployed Vercel URL here in production.
CORS_ALLOW_ORIGINS=http://localhost:5173
